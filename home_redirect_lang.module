<?php

/**
 * @file
 * Provides functionality for handling postal addresses.
 */

use Drupal\Core\Block\BlockPluginInterface;
use Drupal\Core\Hook\Attribute\LegacyHook;
use Drupal\home_redirect_lang\Hook\LanguageSwitcherBlockViewAlterHook;
use Drupal\home_redirect_lang\Hook\PreprocessPageHook;

/**
 * Implements hook_preprocess_HOOK().
 *
 * Legacy shim for Drupal < 11.1, see PreprocessPageHook.
 */
#[LegacyHook]
function home_redirect_lang_preprocess_page(&$variables): void {
  \Drupal::service(PreprocessPageHook::class)($variables);
}

/**
 * Implements hook_block_view_alter().
 *
 * Legacy shim for Drupal < 11.1, see LanguageSwitcherBlockViewAlterHook.
 */
#[LegacyHook]
function home_redirect_lang_block_view_alter(array &$build, BlockPluginInterface $block): void {
  \Drupal::service(LanguageSwitcherBlockViewAlterHook::class)($build, $block);
}
